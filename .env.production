# === Configuración de Producción para hal-noticias-api ===
# Despliegue en: web/noticias.hospitalantoniolorena.gob.pe/private/

# ── Base Path ──────────────────────────────────────────
# Ruta base relativa donde la API está expuesta públicamente
# En HestiaCP con estructura `/api/*` → `/private/public/index.php`
APP_BASE_PATH=/api

# ── Seguridad ──────────────────────────────────────────
# Activar autenticación JWT (requerido en producción)
AUTH_ENABLED=true

# JWT: secreto para firmar tokens (generar con: openssl rand -hex 32)
# ⚠️ CAMBIAR EN PRODUCCIÓN - Este es un valor de ejemplo
JWT_SECRET=your_production_secret_here_change_this_value_now

# Duración del token en segundos (8 horas por defecto)
JWT_TTL=28800

# ── Base de Datos ──────────────────────────────────────
DB_HOST=localhost
DB_NAME=haladminweb_noticias_bd
DB_USER=haladminweb_user
DB_PASS=

# ── CORS ───────────────────────────────────────────────
# Orígenes permitidos (separados por coma).
# - noticias.* = panel de administración (hal-noticias-ui).
# - dominio principal = sitio público (hal-site) que LEE los posts (GET /posts).
# La lectura pública necesita que el dominio principal esté en la allowlist para
# que el navegador (misma política de origen) pueda consumir la API.
CORS_ORIGINS=https://hospitalantoniolorena.gob.pe,https://www.hospitalantoniolorena.gob.pe,https://noticias.hospitalantoniolorena.gob.pe

# ── Email (2FA) ────────────────────────────────────────
SMTP_HOST=mail.hospitalantoniolorena.gob.pe
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noresponder@hospitalantoniolorena.gob.pe
SMTP_PASS=
SMTP_FROM=noresponder@hospitalantoniolorena.gob.pe
SMTP_FROM_NAME="Sistema de Noticias - Hospital Antonio Lorena"

# Bypass de 2FA solo para desarrollo local (NUNCA en producción)
AUTH_2FA_DEV=false

# Servicio de archivos (hal-archivos-api)
FILES_API_BASE_URL=https://archivos.hospitalantoniolorena.gob.pe/files-api
ARCHIVOS_BASE_URL=https://archivos.hospitalantoniolorena.gob.pe/posts

# ── Aplicación ─────────────────────────────────────────
# Debug mode (desactivar en producción)
APP_DEBUG=false

# HTTPS forzado en respuestas de seguridad
APP_SECURE=true
